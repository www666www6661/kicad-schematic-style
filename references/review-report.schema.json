{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent KiCad schematic visual review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "layout",
        "final"
      ],
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "pdf_sha256": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_pages": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "viewed_images": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author_conclusions_seen": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "outside_packet_files_seen": {
          "type": "boolean"
        }
      },
      "required": [
        "author_conclusions_seen",
        "notes",
        "outside_packet_files_seen"
      ]
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functional_reading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unverified",
                "not_applicable"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unverified",
                "not_applicable"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "compactness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unverified",
                "not_applicable"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unverified",
                "not_applicable"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        },
        "paper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unverified",
                "not_applicable"
              ],
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "evidence"
          ]
        }
      },
      "required": [
        "functional_reading",
        "geometry",
        "compactness",
        "pagination",
        "paper"
      ]
    },
    "space_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "level": {
            "type": "string",
            "enum": [
              "within_core",
              "between_cores",
              "across_sheets",
              "paper_trial"
            ]
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "retained",
              "change_needed",
              "unverified"
            ]
          },
          "action_or_constraint": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "page",
          "level",
          "anchors",
          "observation",
          "disposition",
          "action_or_constraint"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "functional_reading",
              "geometry",
              "compactness",
              "pagination",
              "paper"
            ],
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "category",
          "page",
          "references",
          "observation",
          "action"
        ]
      }
    },
    "rechecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "resolved",
              "open",
              "not_applicable",
              "unverified"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "finding_id",
          "status",
          "evidence"
        ]
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probe_considered": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "stage",
    "source_sha256",
    "pdf_sha256",
    "reviewed_pages",
    "viewed_images",
    "isolation",
    "assessments",
    "space_checks",
    "findings",
    "rechecks",
    "unverified",
    "probe_considered"
  ]
}
